@model CreateAddressVM


<div class="container mt-5">
    <h2>افزودن آدرس جدید</h2>
    <form asp-action="CreateAddress" method="post">
        <div class="form-group">
            <label for="StateId">استان</label>
            <select id="StateId" class="form-control">
                <option value="">-- انتخاب استان --</option>
                @foreach (var state in ViewBag.States)
                {
                    <option value="@state.Value">@state.Text</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label asp-for="CityId">شهر</label>
            <select asp-for="CityId" class="form-control" id="CityId">
                <option value="">-- ابتدا استان را انتخاب کنید --</option>
            </select>
            <span asp-validation-for="CityId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FullAddress">آدرس کامل</label>
            <textarea asp-for="FullAddress" class="form-control" id="FullAddress" rows="3"></textarea>
            <span asp-validation-for="FullAddress" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">افزودن آدرس</button>
    </form>
</div>
