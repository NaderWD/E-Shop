@model List<AddressForShowVM>


<div class="container mt-5">
    <h5 class="mb-4">آدرس های من</h5>

    <!-- Add Role Button -->
    <a class="btn btn-primary mb-3" asp-action="CreateAddress" asp-controller="Address">
        افزودن آدرس جدید
    </a>

    @if (Model.Any())
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>نام استان</th>
                    <th>نام شهر</th>
                    <th>آدرس</th>
                    <th>حذف‌</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var address in Model)
                {
                    <tr>
                        <td>@address.StateName</td>
                        <td>@address.CityName</td>
                        <td>@address.FullAddress</td>
                        <td>
                            <div>
                                <span>
                                    <button class="btn rounded-pill btn-danger" type="button" onclick="confirmDelete('deleteForm-@address.AddressId')">
                                        <i class="bx bx-trash me-1"></i> حذف
                                    </button>
                                    <form id="deleteForm-@address.CityName" method="post" action="@Url.Action("DeleteAddress", "Address", new { addressId = address.AddressId, Title = address.CityName })" style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" id="addressId" name="addressId" value="@address.AddressId" />
                                    </form>
                                </span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>آدرسی ثبت نشده است</p>
    }
</div>