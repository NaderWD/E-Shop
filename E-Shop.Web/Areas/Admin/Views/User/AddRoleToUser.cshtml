@model UserRoleVM
@{
    var allRoles = ViewBag.Roles as List<RoleVMForUser>;
    var currentRoles = ViewBag.CurrentRoles as List<RoleVMForUser>;
}


<div class="container mt-5">
    <form asp-action="AddRoleToUser" asp-controller="User" asp-area="Admin" method="post">
        <input type="hidden" name="userId" value="@Model.UserId" />

        <!-- Current Roles -->
        <div class="mb-4">
            <h4>نقش‌های فعلی</h4>
            <div class="row g-2">
                @foreach (var role in currentRoles)
                {
                    <div class="col-3">
                        <div class="list-group-item border rounded">
                            @role.RoleName
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Spacing between sections -->
        <div class="my-4">
            <h4>تمام نقش‌ها</h4>
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @foreach (var role in allRoles)
                {
                    <div class="col">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="role_@role.RoleId"
                                   name="selectedRoleIds"
                                   value="@role.RoleId"
                            @(currentRoles.Any(cr => cr.RoleId == role.RoleId) ? "checked" : "") />
                            <label class="form-check-label" for="role_@role.RoleId">@role.RoleName</label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary">به‌روزرسانی نقش‌ها</button>
    </form>
</div>
