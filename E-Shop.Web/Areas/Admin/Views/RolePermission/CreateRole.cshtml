@model RoleVM
@{
    var permissionTree = ViewBag.PermissionTree as List<PermissionVM>;
}

<div class="container mt-5">
    <h2>ایجاد نقش جدید</h2>
    <form asp-action="CreateRole" asp-controller="RolePermission" asp-area="Admin" method="post">
        <!-- Role Name Input -->
        <div class="row">
            <div class="col-md-6">
                <div class="mb-4">
                    <label for="RoleName" class="form-label">نام نقش</label>
                    <input type="text" class="form-control" id="RoleName" name="RoleName" required />
                </div>
            </div>
        </div>

        <!-- Permissions Section -->
        <h3>دسترسی‌ها</h3>
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var parent in permissionTree)
            {
                <div class="col">
                    <div class="card h-100" style="min-height: 200px;">
                        <div class="card-body">
                            <!-- Parent Checkbox -->
                            <div class="form-check">
                                <input type="checkbox"
                                       class="form-check-input parent-checkbox"
                                       id="permission_@parent.PermissionId"
                                       name="SelectedPermissions"
                                       value="@parent.PermissionId"
                                       onchange="toggleChildren(this, @parent.PermissionId)">
                                <label class="form-check-label fw-bold" for="permission_@parent.PermissionId">@parent.DisplayName</label>
                            </div>
                            <!-- Child Checkboxes -->
                            <div class="ms-4">
                                @foreach (var child in parent.Children)
                                {
                                    <div class="form-check">
                                        <input type="checkbox"
                                               class="form-check-input child-checkbox-@parent.PermissionId"
                                               id="permission_@child.PermissionId"
                                               name="SelectedPermissions"
                                               value="@child.PermissionId"
                                               onchange="toggleParent(this, @parent.PermissionId)">
                                        <label class="form-check-label" for="permission_@child.PermissionId">@child.DisplayName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary mt-3">ایجاد</button>
    </form>
</div>


