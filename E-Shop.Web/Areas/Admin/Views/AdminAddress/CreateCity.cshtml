@model CityVM
@{
    var stateId = ViewBag.stateId;
}


<div class="container mt-5">
    <h2>ایجاد شهر جدید</h2>
    <form asp-action="CreateCity" asp-controller="AdminAddress" asp-area="Admin" method="post">
        <input type="hidden" asp-for="StateId" />
        <!-- Role Name Input -->
        <div class="row">
            <div class="col-md-6">
                <div class="mb-4">
                    <label for="CityName" class="form-label">نام شهر</label>
                    <input type="text" class="form-control" id="CityName" name="CityName" required />
                </div>
            </div>
        </div>
        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary mt-3">ایجاد</button>
    </form>
</div>


